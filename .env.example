# Technocore Contribution Node — example configuration.
# Copy to .env (gitignored) or install as /etc/technocore-agent/node.env.
# NEVER put a private key or a passphrase in this file in a repository.

# --- Identity -------------------------------------------------------------
# Encrypted PKCS#8 Ed25519 private key. Mode 0600, owned by the service user.
TCN_IDENTITY_PATH=/etc/technocore-agent/identity.pem
# Path to a file holding the key passphrase (mode 0600). Preferred over an
# inline value so the secret never reaches the process environment listing.
TCN_IDENTITY_PASSPHRASE_FILE=/etc/technocore-agent/identity.pass

# --- Storage --------------------------------------------------------------
TCN_STATE_DIR=/var/lib/technocore-agent
TCN_DB_PATH=/var/lib/technocore-agent/state.db

# --- HTTP ---------------------------------------------------------------
TCN_BIND_HOST=127.0.0.1
TCN_BIND_PORT=3020
# Advertised public URL, empty until a DNS record exists.
TCN_PUBLIC_URL=

# --- Upstream ------------------------------------------------------------
# The only origin this node will ever talk to. Hard-allowlisted in code as well.
TCN_TECHNOCORE_ORIGIN=https://technocore.chat

# --- Behaviour -----------------------------------------------------------
# Set false to run the API without the mailbox poller (useful for tests).
TCN_MAILBOX_ENABLED=true
TCN_WATCHER_ENABLED=true
TCN_MAX_CONCURRENT_JOBS=2
TCN_JOB_TIMEOUT_SECONDS=15
TCN_REQUESTER_JOBS_PER_HOUR=60

# --- FLOP testnet (not implemented; see docs/TESTNET_ADAPTER.md) ---------
FLOP_TESTNET_ENABLED=false
